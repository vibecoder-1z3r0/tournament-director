# Tournament Director API Environment Variables
# Copy this file to .env and customize as needed
#
# All settings can be prefixed with TD_ (e.g., TD_BACKEND_TYPE)
# Priority order: CLI args > env vars > config file > defaults
#
# AIA EAI Hin R Claude Code [Sonnet 4.5] v1.0

# Backend Configuration
TD_BACKEND_TYPE=mock
# Options: mock | local | sqlite | postgresql | mysql | mariadb

# Local Backend (when backend_type=local)
TD_LOCAL_DATA_PATH=./data

# Database Backend (when backend_type is a database)
# SQLite example:
# TD_DATABASE_URL=sqlite+aiosqlite:///./tournament.db

# PostgreSQL example:
# TD_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tournament_director

# MySQL example:
# TD_DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/tournament_director

# Server Configuration
TD_HOST=0.0.0.0
TD_PORT=8000
TD_DEBUG=true
TD_RELOAD=true

# CORS Configuration (comma-separated list)
TD_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
TD_CORS_ALLOW_CREDENTIALS=true

# Pagination
TD_DEFAULT_PAGE_SIZE=20
TD_MAX_PAGE_SIZE=100

# Application Info
TD_TITLE=Tournament Director API
TD_VERSION=0.1.0
